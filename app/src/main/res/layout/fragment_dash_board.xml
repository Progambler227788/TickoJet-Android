<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <!-- Top Bar: Gradient Background + Location Picker + Username -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/gradient_top_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Location Picker -->
        <TextView
            android:id="@+id/tv_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hello, Talha"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:drawablePadding="2dp"
            android:gravity="start"
            android:paddingVertical="4dp" />

        <de.hdodenhof.circleimageview.CircleImageView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/profile_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/avatar2"
            android:paddingHorizontal="8dp"
            android:gravity="end"
            app:civ_border_width="2dp"
            app:civ_border_color="#FF000000"/>
    </LinearLayout>

    <!-- Search Bar with Glassmorphism Effect -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:radius="32dp"
        app:cardElevation="16dp"
        app:cardCornerRadius="12dp"

        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp">

            <!-- Search Icon -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <!-- Search Input -->
            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search events..."
                android:backgroundTint="@color/glassmorphism_background"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:padding="10dp"
                android:inputType="text"
                />

            <!-- Filter Button -->
            <ImageView
                android:id="@+id/btn_filter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_filter"
                android:background="@drawable/rounded_button_bg"
                android:padding="10dp"
                android:layout_marginEnd="8dp"
                app:tint="@color/deep_orange" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Upcoming Events Section -->
    <TextView
        android:id="@+id/tv_trending_events"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trending Events"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- See All Button for Upcoming Events -->
    <TextView
        android:id="@+id/tv_see_all_upcoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="See All"
        android:textSize="14sp"
        android:textColor="@color/deep_orange"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tv_trending_events"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Horizontal RecyclerView for Upcoming Events -->
    <com.talhaatif.tickojet.custom.StatefulRecyclerView
        android:id="@+id/trendingEventsView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:nestedScrollingEnabled="false"
        tools:listitem="@layout/rv_event_featured"
        app:emptyText="No trending events found"
        app:emptyIcon="@drawable/empty"
        app:errorText="Failed to load events"
        app:errorIcon="@drawable/error"
        app:layout_constraintTop_toBottomOf="@id/tv_trending_events"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Upcoming Events Section -->
    <TextView
        android:id="@+id/tv_upcoming_events"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upcoming Events"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/trendingEventsView"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- See All Button for Recommended Events -->
    <TextView
        android:id="@+id/tv_see_all_recommended"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="See All"
        android:textSize="14sp"
        android:textColor="@color/deep_orange"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tv_upcoming_events"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Vertical RecyclerView for Recommended Events -->
    <com.talhaatif.tickojet.custom.StatefulRecyclerView
        android:id="@+id/upcomingEventsView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:nestedScrollingEnabled="false"
        tools:listitem="@layout/rv_event"
        app:emptyText="No trending events found"
        app:emptyIcon="@drawable/empty"
        app:errorText="Failed to load events"
        app:errorIcon="@drawable/error"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/tv_upcoming_events"
        app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>