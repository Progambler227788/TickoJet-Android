<!-- res/drawable/rounded_button_bg.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid background color -->
    <solid android:color="@color/white"/> <!-- Change this to your desired color -->

    <!-- Rounded corners -->
    <corners android:radius="20dp"/> <!-- Adjust the radius for desired roundness -->

    <!-- Optional: Add a stroke (border) -->
    <stroke
        android:width="1dp"
        android:color="@color/deep_orange"/> <!-- Change stroke color if needed -->
</shape>