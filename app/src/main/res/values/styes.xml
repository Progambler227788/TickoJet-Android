<resources>
    <!-- Base Text Style -->
    <style name="TextStyle">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Bold Text Style -->
    <style name="TextStyle.Bold" parent="TextStyle">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Primary Text Style -->
    <style name="TextStyle.Primary" parent="TextStyle">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Secondary Text Style -->
    <style name="TextStyle.Secondary" parent="TextStyle">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Status Button Style -->
    <style name="ButtonStyle.Status" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/success_green</item>
        <item name="strokeWidth">1dp</item>
    </style>


    <style name="Widget.TickoJet.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.TickoJet.BottomNavigationView</item>
    </style>

    <style name="ThemeOverlay.TickoJet.BottomNavigationView" parent="">
        <item name="colorSurface">?attr/colorPrimary</item>
        <item name="colorOnSurface">@color/white</item>
    </style>






</resources>